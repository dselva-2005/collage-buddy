<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Orders</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome for arrow icon -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <!-- Home Link with Arrow Icon -->
    <a href="/" class="btn btn-outline-secondary mb-4">
      <i class="fas fa-arrow-left"></i> Back to Home
    </a>

    <h1 class="text-center mb-4">User Orders</h1>

    <% if (message) { %>
      <div class="alert alert-info text-center" role="alert">
        <%= message %>
      </div>
    <% } else { %>
      <div class="row">
        <% orders.forEach(order => { %>
          <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title">Order ID: <%= order._id %></h5>
                <p class="card-text">
                  <strong>Total Amount:</strong> $<%= order.totalAmount %> <br>
                  <strong>Status:</strong> 
                  <% if (order.status === 'Completed') { %>
                    <span class="badge bg-success">Completed</span>
                  <% } else if (order.status === 'Pending') { %>
                    <span class="badge bg-warning">Pending</span>
                  <% } else { %>
                    <span class="badge bg-danger">Cancelled</span>
                  <% } %> <br>
                  <strong>Created At:</strong> <%= new Date(order.createdAt).toLocaleString() %>
                </p>
                <!-- View Items Button -->
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#items-<%= order._id %>" aria-expanded="false">
                  View Items
                </button>
                <!-- Print Bill Button -->
                <a href="/order/<%= order._id %>" class="btn btn-outline-success mt-2">
                  <i class="fas fa-print"></i> Print Bill
                </a>
                <div class="collapse mt-3" id="items-<%= order._id %>">
                  <ul class="list-group">
                    <% order.items.forEach(item => { %>
                      <li class="list-group-item d-flex justify-content-between align-items-center">
                        <%= item.name %>
                        <span>Qty: <%= item.quantity %> - $<%= item.price %></span>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>

  <!-- Bootstrap JS and Popper.js -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
