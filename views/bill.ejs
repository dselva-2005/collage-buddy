<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 10px;
            border: 1px solid #000;
            text-align: left;
        }
        .total {
            font-weight: bold;
        }
        /* Print styles */
        @media print {
            #printButton {
                display: none; /* Hide the print button when printing */
            }
            #homeButton {
                display: none; /* Hide the home button when printing */
            }
        }
    </style>
</head>
<body>
    <h1>Invoice</h1>
    <p><strong>Order ID:</strong> <span id="orderId"></span></p>
    <p><strong>User ID:</strong> <span id="userId"></span></p>
    <p><strong>Status:</strong> <span id="status"></span></p>
    <table>
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody id="itemsTable"></tbody>
    </table>
    <p class="total">Total Amount: $<span id="totalAmount"></span></p>
    <button id="printButton" onclick="window.print()">Print Bill</button>
    <button id="homeButton" onclick="window.location.href='/'">Return to Home</button>

    <script>
        // Assuming you have a way to pass the order details to the front end
        const order = <%- JSON.stringify(order) %>;

        document.getElementById('orderId').innerText = order._id;
        document.getElementById('userId').innerText = order.userId;
        document.getElementById('status').innerText = order.status;

        let itemsTable = '';
        order.items.forEach(item => {
            itemsTable += `<tr>
                <td>${item.name}</td>
                <td>$${item.price.toFixed(2)}</td>
                <td>${item.quantity}</td>
                <td>$${(item.price * item.quantity).toFixed(2)}</td>
            </tr>`;
        });
        document.getElementById('itemsTable').innerHTML = itemsTable;
        document.getElementById('totalAmount').innerText = order.totalAmount.toFixed(2);
    </script>
</body>
</html>
