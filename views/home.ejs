<!DOCTYPE html>
<html>

<body>
<%- include('header') %>
    <section class="home" id="home">
        <div class="content">
            <h3>Welcome <%- user.firstName %> </h3>
            <p></p>
            <p></p>
            <h3>
                All Useful Stationery Avalaible For You</h3>
            <p>This website provides all the stationery items you will need when you attend college.</p>

            <a href="products/all" class="btn">Shop Now</a>
        </div>
    </section>

    <!-- our feature--section -->
    <section class="features" id="features">
        <h1 class="heading"> our <span>My orders</span> </h1>
        <div class=" box-container">

            <div class="box">
                <img src="/images/i1.jpg ">
                <h3>High-quality</h3>

                <p>we maintain high quality of the product</p>
                <a href="#" class="btn">read more</a>
            </div>

            <div class="box">
                <img src="/images/i2.jpeg ">
                <h3>warranty and support</h3>

                <p>Offer warranty ,guarante ,or support for customer satisfaction.</p>
                <a href="#" class="btn">read more</a>
            </div>

            <div class="box">
                <img src="/images/i3.png ">
                <h3>improvement</h3>

                <p>improve product quality based on customer feedback and market trends</p>
                <a href="#" class="btn">read more</a>

            </div>
    </section>
    <!-- our feature section -->
    <section class="products" id="products">
        <h1 class="heading"> our <span>products</span></h1>
    
        <div class="swiper product-slider">
            <div class="swiper-wrapper">
                <% products.forEach(product => { %>
                    <div class="swiper-slide box" id="<%= product.id %>" >
                        <img src="<%= product.image %>" alt="<%= product.name %>" class="card-img"  onclick="specific_page(event)">
                        <h1><%= product.name %></h1>
                        <div class="price"> ₹<%= product.price %></div>
                        <div class="stars">
                            <% for (let i = 0; i < Math.floor(product.ratings); i++) { %>
                                <i class="fa fa-star"></i>
                            <% } %>
                            <% if (product.ratings % 1 !== 0) { %>
                                <i class="fa fa-star-half"></i>
                                <i class="fa fa-star-half"></i>
                            <% } %>
                            <% for (let i = Math.ceil(product.ratings); i < 5; i++) { %>
                                <i class="fa fa-star-o"></i>
                            <% } %>
                        </div>
                        <a  onclick="addTocart(event)" class="btn">Add to Cart</a>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    

    <section class="review" id="review">
        <h1 class="heading"> customer's<span>review</span></h1>
        <div class="swiper review-slider">
            <div class="swiper-wrapper">
                <% testimonies.forEach(element => { %>
                    <div class="swiper-slider box">
                        <img src="/images/image.png">
                        <p><%- element.review %>
                        </p>
                        <h3> <%- element.userName %> </h3>
                        <div class="stars">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star-half"></i>
    
                        </div>
                    </div>
                <% }); %>
                
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script src="/js/sc.js"></script>
</body>

</html>